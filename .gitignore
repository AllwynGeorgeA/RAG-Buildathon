.venv/
.venv-1/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# env
.env
*.local

# data — most of this is regenerated by the ingestion pipeline and not
# versioned. The one exception is data/raw/vikaspedia_documents.json: the
# real output of an actual Playwright crawl against live Vikaspedia (see
# README "Data ingestion"), checked in so DEMO_MODE works offline without
# requiring a live crawl. Everything derived from it (vector store, graph,
# per-document audit JSON) is rebuilt locally via scripts/demo_seed.py or
# scripts/build_index.py + scripts/build_graph.py.
data/raw/*
!data/raw/.gitkeep
!data/raw/vikaspedia_documents.json
data/processed/*
!data/processed/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/vector_store/*
!data/vector_store/.gitkeep
data/knowledge_graph/*
!data/knowledge_graph/.gitkeep
data/conversations.db

# logs
*.log
logs/
streamlit_log.txt
fastapi_log.txt

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Go
go-service/bin/

# streamlit
.streamlit/secrets.toml
