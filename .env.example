# ==========================================================================
# KrishiMitra AI — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ==========================================================================

# ---- LLM (OpenAI) ---------------------------------------------------------
# Required for full answer generation. If unset, the system falls back to a
# deterministic extractive answer builder (no hallucination risk, but less
# fluent prose) — see app/llm/answer_generator.py.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_AUDIO_MODEL=whisper-1
OPENAI_REQUEST_TIMEOUT_SECONDS=30

# ---- Embeddings ------------------------------------------------------------
# Default is a strong multilingual sentence-transformers model suitable for
# Indian languages (English/Hindi/Tamil among others).
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DEVICE=cpu

# ---- Vector store ------------------------------------------------------------
# chroma (default, persistent local) or qdrant_local
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PATH=data/vector_store
VECTOR_STORE_COLLECTION=krishimitra_schemes

# ---- Knowledge graph --------------------------------------------------------
KNOWLEDGE_GRAPH_PATH=data/knowledge_graph/graph.gpickle

# ---- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.32
RERANK_TOP_K=5

# ---- OCR / Speech-to-text ------------------------------------------------------
OCR_PROVIDER=pytesseract
OCR_MIN_CONFIDENCE=45
STT_PROVIDER=openai
TESSERACT_CMD=

# ---- Crawler -------------------------------------------------------------------
CRAWL_CONFIG_PATH=config/crawl.yaml
CRAWL_USER_AGENT=KrishiMitraAI-Bot/1.0 (+educational-research; contact: allwyn.george@quvia.ai)
CRAWL_RATE_LIMIT_SECONDS=2.0
CRAWL_MAX_RETRIES=3
CRAWL_REQUEST_TIMEOUT_SECONDS=30

# ---- Optional supplementary guardrail/eval layers ----
# Defense-in-depth on top of the deterministic guardrails in app/guardrails/ —
# NOT required for the app to work correctly; see docs/architecture.md.
NEMO_GUARDRAILS_ENABLED=false
NEMO_GUARDRAILS_CONFIG_PATH=config/nemo_guardrails
DEEPEVAL_ENABLED=false

# ---- Uploads / security ----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.xlsx,.xls,.csv,.wav,.mp3,.m4a

# ---- App behaviour ----------------------------------------------------------------
DEMO_MODE=true
DEBUG_MODE=false
DEFAULT_LANGUAGE=en
APP_ENV=development
LOG_LEVEL=INFO

# ---- API ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
